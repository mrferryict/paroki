# ==============================================================================
# ENVIRONMENT & SECRETS
# ==============================================================================
.env
.env.*
!.env.example
!.env.*.example
.db_password

# ==============================================================================
# DEPENDENCIES (COMPOSER & NODE)
# ==============================================================================
/vendor/
composer.phar
# Always track composer.lock — required for reproducible installs across machines.
# DO NOT add composer.lock below this line.

/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Always track package-lock.json / yarn.lock / pnpm-lock.yaml for the same reason
# as composer.lock — do not ignore lock files.

# ==============================================================================
# BUILD & COMPILE OUTPUTS
# ==============================================================================
/public/build/
/dist/
/build/
.vite/
/public/hot

# ==============================================================================
# CACHE & TEMP DIRECTORIES
# ==============================================================================
/cache/
/tmp/
/temp/

# ==============================================================================
# CODEIGNITER 4 CORE DIRECTORIES
# ==============================================================================
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
php_errors.log
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

# ==============================================================================
# LOCAL DEV SSL/TLS CERTIFICATES (mkcert — regenerated per machine by
# create-project-ci4.sh; never commit a private key or leaf cert)
# ==============================================================================
/certs/
/.certs/
*.pem
*.key
*.crt
*.csr

# ==============================================================================
# DATABASE DUMPS / LOCAL BACKUPS
# ==============================================================================
/database/dumps/
/database/backups/
*.sql.gz

# ==============================================================================
# IDEs & EDITORS
# ==============================================================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ==============================================================================
# AI TOOLS & AGENTS
# (.cursorrules and CONTEXT.md themselves are NOT ignored — they must stay
# tracked at the project root per the global coding standard.)
# ==============================================================================
.cursor/
.cursor-cache/
.cursor-tutor/
.claude/
.roo/
.aider*
.continue/

# ==============================================================================
# PHP QUALITY & TOOLING CACHES
# ==============================================================================
.phpunit.cache/
.phpunit.result.cache
/coverage/
.php-cs-fixer.cache
.phpstan.cache/
.rector.cache/
.phpactor.json
.intelephense/

# ==============================================================================
# OPERATING SYSTEMS & SYSTEM LOGS
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini

# Linux / WSL system files
*.pid
*.sock
*.log

# Generic temporary files
*.tmp
*.temp
*.bak
*.swp
*~